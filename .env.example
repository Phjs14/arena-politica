NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SOMENTE servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Sal para o hash do votante (string longa e aleatória)
VOTER_HASH_SALT=troque-por-uma-string-longa-e-aleatoria
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com
# Opcional (rate limit distribuído). Sem isso, usa fallback em memória (só dev/instância única).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# true = votação liberada | false = pausa novos votos (placar continua visível)
NEXT_PUBLIC_VOTING_ENABLED=true
